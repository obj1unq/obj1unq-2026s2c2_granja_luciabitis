import wollok.game.*
import granja.*
import src.cultivos.*

describe "test de la granja" {
  test "personaje" {
    personaje.genero(masculino)
    assert.equals("m-player-normal.png", personaje.image())
  }
  
  test "personajeF" {
    personaje.genero(femenino)
    assert.equals("f-player-normal.png", personaje.image())
  }
  
  test "sembrar" {
    granja.vaciar()
    personaje.position(game.at(3, 3))
    const unTomaco = new Tomaco()
    personaje.plantar(unTomaco)
    assert.equals(game.at(3, 3), unTomaco.position())
    assert.equals([unTomaco], granja.cultivos())
    const trigardo = new Trigo()
    assert.throwsException({ personaje.plantar(trigardo) })
    personaje.position(game.at(4, 4))
    personaje.plantar(trigardo)
    assert.equals(game.at(4, 4), trigardo.position())
    assert.equals([unTomaco, trigardo], granja.cultivos())
  }
  
  test "regar" {
    personaje.position(game.at(2, 2))
    assert.throwsException({ personaje.regar() })
    personaje.position(game.at(1, 1))
    const unMaiz = new Maiz()
    personaje.plantar(unMaiz)
    assert.equals("maiz_bebe.png", unMaiz.image())
    personaje.regar()
    assert.equals("maiz_adulto.png", unMaiz.image())
    personaje.regar()
    assert.equals("maiz_adulto.png", unMaiz.image())
    personaje.position(game.at(2, 2))
    const unTrigo = new Trigo()
    personaje.plantar(unTrigo)
    assert.equals("trigo_0.png", unTrigo.image())
    personaje.regar()
    assert.equals("trigo_1.png", unTrigo.image())
    personaje.regar()
    assert.equals("trigo_2.png", unTrigo.image())
    personaje.regar()
    assert.equals("trigo_3.png", unTrigo.image())
    personaje.regar()
    assert.equals("trigo_0.png", unTrigo.image())
  }
  
  test "tomaco regado" {
    game.width(5)
    game.height(5)
    personaje.position(game.at(3, 3))
    const unTomaco = new Tomaco()
    personaje.plantar(unTomaco)
    personaje.regar()
    assert.equals(game.at(3, 4), unTomaco.position())
    personaje.position(game.at(3, 4))
    personaje.regar()
    assert.equals(game.at(3, 0), unTomaco.position())
    personaje.position(game.at(3, 1))
    personaje.plantar(new Trigo())
    personaje.position(game.at(3, 0))
    personaje.regar()
    assert.equals(game.at(3, 0), unTomaco.position())
  }
  
  test "cosecha" {
    personaje.position(game.at(3, 3))
    assert.throwsException({ personaje.cosechar() })
    const unTomaco = new Tomaco()
    personaje.plantar(unTomaco)
    personaje.cosechar()
    assert.that(granja.cultivos().isEmpty())
    assert.equals([unTomaco], bolso.cosecha())
    const unMaiz = new Maiz()
    personaje.plantar(unMaiz)
    assert.throwsException({ personaje.cosechar() })
    personaje.regar()
    personaje.cosechar()
    assert.that(granja.cultivos().isEmpty())
    assert.equals([unTomaco, unMaiz], bolso.cosecha())
    const unTrigo = new Trigo()
    personaje.plantar(unTrigo)
    assert.throwsException({ personaje.cosechar() })
    personaje.regar()
    assert.throwsException({ personaje.cosechar() })
    personaje.regar()
    assert.that(unTrigo.listoParaCosecha())
    personaje.regar()
    personaje.cosechar()
    assert.that(granja.cultivos().isEmpty())
    assert.equals([unTomaco, unMaiz, unTrigo], bolso.cosecha())
  }
  
  test "vender trigo, maiz y tomaco" {
    personaje.plantar(new Trigo())
    personaje.regar()
    personaje.regar()
    personaje.regar()
    personaje.cosechar()
    assert.equals(200, bolso.oroPorConseguir())
    assert.equals(1, bolso.cosechaTotal())
    personaje.plantar(new Maiz())
    personaje.regar()
    personaje.cosechar()
    assert.equals(350, bolso.oroPorConseguir())
    assert.equals(2, bolso.cosechaTotal())
    personaje.plantar(new Tomaco())
    personaje.cosechar()
    assert.equals(430, bolso.oroPorConseguir())
    assert.equals(3, bolso.cosechaTotal())
    personaje.vender()
    assert.equals(430, bolso.oroTotal())
    assert.equals(0, bolso.cosechaTotal())
  }
}